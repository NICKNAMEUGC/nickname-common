# nickname-common — Variables de entorno
# Estas variables las usan los módulos de la librería compartida.
# Cada agente que use nickname-common debe tener estas vars en su propio .env.

# Logging
LOG_LEVEL=INFO

# Odoo XML-RPC (usado por odoo_client.OdooService)
ODOO_URL=https://tu-empresa.odoo.com
ODOO_DB=tu_base_datos
ODOO_USERNAME=admin@tu-empresa.com
ODOO_API_KEY=tu_api_key_aqui
ODOO_COMPANY_ID=2
ODOO_XMLRPC_TIMEOUT=20
ODOO_CIRCUIT_BREAKER_TIMEOUT=60

# HubSpot REST (usado por hubspot_client.BaseHubSpotService)
HUBSPOT_ACCESS_TOKEN=pat-xxxx-xxxx-xxxx

# xAI (Fase 1 dry — NO provisionar ni poner NK_XAI_LIVE=1 sin OK de billing)
# XAI_API_KEY=
# NK_XAI_LIVE=0
# NK_MODEL_GROK_FAST=grok-3-mini
# NK_MODEL_GROK_QUALITY=grok-4

# Enrutador OpenRouter (llm.complete con NK_ROUTER=openrouter)
# NK_ROUTER=openrouter
# OPENROUTER_API_KEY=
# NK_AGENT_NAME=nombre-del-servicio   # desglose de gasto por agente (X-Title)

# Cascada de fallback multi-proveedor (mandato 2026-08-31,
# LLM-FALLBACK-OPENROUTER-MANDATORY). Cada leg se activa por PRESENCIA de su
# credencial; sin credencial se salta. NO crear keys nuevas sin OK de Diego:
# activar billing OpenAI/Anthropic es decisión suya.
# GEMINI_API_KEY=            # leg gemini_directo (alias aceptado: GOOGLE_AI_API_KEY)
# OPENAI_API_KEY=            # leg openai
# ANTHROPIC_API_KEY=         # leg anthropic
# NK_MODEL_OPENAI_FALLBACK=gpt-4o-mini
# NK_MODEL_ANTHROPIC_FALLBACK=claude-haiku-4-5-20251001
